rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all security net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to determine if the user is the bootstrapped admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email.lower() == "kyleheiser@gmail.com";
    }

    // Secure sandboxed user directory structure
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /compounds/{compoundId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /doseLogs/{doseLogId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /metrics/{metricId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Members verification and access approval system
    match /members/{memberId} {
      allow read: if request.auth != null && (request.auth.uid == memberId || isAdmin());
      
      // Creating a request: status must start as 'pending'
      allow create: if request.auth != null && 
                    request.auth.uid == memberId && 
                    request.resource.data.status == "pending";
      
      // Updates: user can change shipping details/phone, but status can only be modified by Admin
      allow update: if request.auth != null && (
                      isAdmin() || 
                      (request.auth.uid == memberId && request.resource.data.status == resource.data.status)
                    );
                    
      allow delete: if isAdmin();
    }

    // Premium Shop Inventory catalog
    match /shopItems/{itemId} {
      // Allowed if Admin, or if authenticated and approved member in the members collection
      allow read: if request.auth != null && (
                    isAdmin() ||
                    (
                      exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
                      (
                        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "approved" ||
                        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "kit" ||
                        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "chinakit" ||
                        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "chinavial"
                      )
                    )
                  );

      allow write: if isAdmin();
    }

    // Global system configuration settings
    // 'shop' holds only the global shop-visibility flag and must stay readable
    // by guests at app startup. 'pricingConfig' holds the markup strategy and
    // is admin-only — members get computed sell prices from /api/prices, so
    // exposing markups here would let them reverse-engineer wholesale costs.
    match /systemConfig/{configId} {
      allow read: if configId == "shop"
                  || isAdmin()
                  || (request.auth != null && configId != "pricingConfig");
      allow write: if isAdmin();
    }

    // Admin-managed settings (pricing config, etc.)
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // FCM push profile — user writes their own, server reads via Admin SDK (bypasses rules)
    match /pushProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Push dedup guards — written server-side only via Admin SDK; deny all client access
    match /pushGuards/{guardId} {
      allow read, write: if false;
    }

    // Orders checkout data
    match /orders/{orderId} {
      // Customers may read only their own orders; order docs contain PII
      // (shipping addresses, phone numbers) so there is no broad member read.
      // Admin inventory math reads all orders via isAdmin().
      allow read: if request.auth != null && (
                    resource.data.userId == request.auth.uid ||
                    isAdmin()
                  );

      // Orders are created exclusively through /api/create-order (Admin SDK,
      // bypasses these rules) so prices are always recomputed server-side.
      // Direct client creation is admin-only.
      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }
  }
}

