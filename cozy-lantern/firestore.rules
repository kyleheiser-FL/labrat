rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isFamilyAdminOrOwner(familyId) {
      return isFamilyMember(familyId) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
          .data.role in ['owner', 'admin'];
    }

    function acceptedFriendConnectionId(targetUserId) {
      let id1 = request.auth.uid < targetUserId
        ? request.auth.uid + '_' + targetUserId
        : targetUserId + '_' + request.auth.uid;
      return id1;
    }

    function hasAcceptedFriendWithSharing(targetUserId) {
      let connId = request.auth.uid < targetUserId
        ? request.auth.uid + '_' + targetUserId
        : targetUserId + '_' + request.auth.uid;
      return isSignedIn() &&
        exists(/databases/$(database)/documents/friendConnections/$(connId)) &&
        get(/databases/$(database)/documents/friendConnections/$(connId)).data.status == 'accepted' &&
        get(/databases/$(database)/documents/friendConnections/$(connId)).data.locationSharingEnabled == true;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── locations ───────────────────────────────────────────────────────────
    match /locations/{userId} {
      allow read, write: if isOwner(userId);

      // Family members can read if subject has location sharing on and same family
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.settings.locationSharing == true &&
        get(/databases/$(database)/documents/users/$(userId)).data.familyId != null &&
        isFamilyMember(get(/databases/$(database)/documents/users/$(userId)).data.familyId);

      // Friend with accepted + location sharing enabled connection can read
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.settings.locationSharingWithFriends == true &&
        hasAcceptedFriendWithSharing(userId);

      // History subcollection — same read access as parent location doc
      match /history/{timestamp} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/users/$(userId)).data.settings.locationSharing == true &&
          get(/databases/$(database)/documents/users/$(userId)).data.familyId != null &&
          isFamilyMember(get(/databases/$(database)/documents/users/$(userId)).data.familyId);
      }
    }

    // ─── families ────────────────────────────────────────────────────────────
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn();
      allow update: if isFamilyAdminOrOwner(familyId);
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
          .data.role == 'owner';

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isOwner(memberId);
        allow update: if isOwner(memberId) || isFamilyAdminOrOwner(familyId);
        allow delete: if isOwner(memberId) || isFamilyAdminOrOwner(familyId);
      }
    }

    // ─── friendConnections ────────────────────────────────────────────────────
    match /friendConnections/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.userIds &&
        request.resource.data.status == 'pending' &&
        request.resource.data.initiatedBy == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    // ─── familyEvents ────────────────────────────────────────────────────────
    match /familyEvents/{eventId} {
      allow read: if isSignedIn() && isFamilyMember(resource.data.familyId);
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isFamilyMember(request.resource.data.familyId);
      allow update: if isSignedIn() && isFamilyMember(resource.data.familyId) && (
        resource.data.createdBy == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
    }

    // ─── familyTasks ─────────────────────────────────────────────────────────
    match /familyTasks/{taskId} {
      allow read: if isSignedIn() && isFamilyMember(resource.data.familyId);
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isFamilyMember(request.resource.data.familyId);
      // Any family member can update (complete, reassign)
      allow update: if isSignedIn() && isFamilyMember(resource.data.familyId);
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
    }

    // ─── familyAnnouncements ─────────────────────────────────────────────────
    match /familyAnnouncements/{announcementId} {
      allow read: if isSignedIn() && isFamilyMember(resource.data.familyId);
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isFamilyMember(request.resource.data.familyId);
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId) ||
        // Any member can mark as read (only readBy field changes)
        (isFamilyMember(resource.data.familyId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']))
      );
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isFamilyAdminOrOwner(resource.data.familyId)
      );
    }

    // ─── pushProfiles ─────────────────────────────────────────────────────────
    match /pushProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
