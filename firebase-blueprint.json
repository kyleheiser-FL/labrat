{
  "entities": {
    "compound": {
      "title": "Compound",
      "description": "An active cycle compound or anabolic/peptide dosage schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "vialSizeMg": { "type": "number" },
        "bacWaterMl": { "type": "number" },
        "doseAmount": { "type": "number" },
        "doseUnit": { "type": "string" },
        "frequency": { "type": "string" },
        "customDays": { "type": "number" },
        "startDate": { "type": "string" },
        "durationWeeks": { "type": "number" },
        "notes": { "type": "string" },
        "color": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "steroidForm": { "type": "string" },
        "pillSizeMg": { "type": "number" },
        "oilConcMgMl": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type", "doseAmount", "doseUnit", "frequency", "startDate", "durationWeeks", "color"]
    },
    "doseLog": {
      "title": "DoseLog",
      "description": "Historic dose administration tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "compoundId": { "type": "string" },
        "compoundName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "doseAmount": { "type": "number" },
        "doseUnit": { "type": "string" },
        "calculatedQtyText": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "compoundId", "compoundName", "date", "time", "doseAmount", "doseUnit"]
    },
    "dailyMetric": {
      "title": "DailyMetric",
      "description": "Daily biometrics tracking card.",
      "type": "object",
      "properties": {
        "userIdAndDate": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "weightLb": { "type": "number" },
        "mood": { "type": "number" },
        "fatigue": { "type": "number" },
        "sideEffects": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["userIdAndDate", "userId", "date"]
    },
    "notification": {
      "title": "Notification",
      "description": "In-app system notification or custom reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "timestamp", "type", "isRead"]
    },
    "member": {
      "title": "Member",
      "description": "Approved retail store member access profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "blocked"] },
        "shippingAddress": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "status"]
    },
    "shopItem": {
      "title": "ShopItem",
      "description": "Premium product offered in the members only store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "inventory": { "type": "number" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "price", "inventory"]
    },
    "order": {
      "title": "Order",
      "description": "Shopping order submitted by members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingInfo": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "email", "items", "total", "shippingInfo", "status"]
    }
  },
  "firestore": {
    "users/{userId}/compounds/{compoundId}": {
      "schema": "compound",
      "description": "Subcollection of compounds per user"
    },
    "users/{userId}/doseLogs/{doseLogId}": {
      "schema": "doseLog",
      "description": "Subcollection of historic dosage logs per user"
    },
    "users/{userId}/metrics/{metricId}": {
      "schema": "dailyMetric",
      "description": "Subcollection of daily metrics logs per user"
    },
    "users/{userId}/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Subcollection of notification items per user"
    },
    "members/{userId}": {
      "schema": "member",
      "description": "Central collection tracking approved shop accounts"
    },
    "shopItems/{itemId}": {
      "schema": "shopItem",
      "description": "Central catalog listing premium biochemical inventory"
    },
    "orders/{orderId}": {
      "schema": "order",
      "description": "Central history registry for checkout requests"
    }
  }
}
