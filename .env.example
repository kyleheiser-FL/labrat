# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://labratapp.app"

# VITE_CUSTOM_AUTH_DOMAIN: Optional custom domain for Google Auth / Firebase Sign-In.
# Replace the default "gen-lang-client-..." string with your custom domain (e.g., "labratapp.com" or "app.labrat.app").
VITE_CUSTOM_AUTH_DOMAIN=""

# VITE_USE_FIREBASEAPP_DOMAIN: Set to "true" to force standard "firebaseapp.com" for Google login redirects
# rather than replacing it with "web.app" (use this if web.app is not added in GCP Authorized Redirect URIs).
VITE_USE_FIREBASEAPP_DOMAIN="false"

# VITE_APP_STORE_COMPLIANT: If set to "true", hides the "Shop" peptide buying tab by default.
# Leave empty or set to "false" to retain the shop for off-store builds sent to friends.
VITE_APP_STORE_COMPLIANT="false"
